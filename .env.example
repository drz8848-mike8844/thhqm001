# ============================================================
# 东方幻绮梦论坛 - 环境变量模板
#
# 用法：cp .env.example .env   然后按需修改
# 注意：.env 已被 .gitignore 忽略，不会被提交；此模板可安全入库。
# 完整说明见 README.md「快速开始」章节。
# ============================================================

# ---------- 隧道/域名配置（重点） ----------
# 对外访问域名，逗号分隔可多写（localhost/127.0.0.1/pythonanywhere 已默认允许）
ALLOWED_HOSTS=你的隧道域名或服务器域名
# HTTPS 隧道/反代必须登记完整 Origin（https://host），否则 POST 表单 403
CSRF_TRUSTED_ORIGINS=https://你的隧道域名
# Cloudflare / ngrok 等 TLS 反代（边缘终结 HTTPS）必须 true；纯本地 http 设 false
TRUST_X_FORWARDED_PROTO=true

# ---------- 初始超级管理员（首次部署 / 重置密码用） ----------
ADMIN_USER=admin
ADMIN_PASS=请改成强密码
# ADMIN_EMAIL=admin@example.com
# ADMIN_RESET_PASSWORD=true    # 管理员已存在时是否按 .env 重置密码（默认 false）

# ---------- 邮件 SMTP（可选，发验证/重置邮件才需要） ----------
# EMAIL_HOST_USER=你的邮箱@163.com
# EMAIL_HOST_PASSWORD=你的163授权码